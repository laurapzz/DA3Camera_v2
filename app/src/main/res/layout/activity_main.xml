
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CameraDepthLane"
            android:textSize="30sp"
            android:textStyle="bold"
            android:layout_marginTop="30dp"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Depth Estimation, Segmentation and Classification"
            android:textSize="16sp"
            android:gravity="center"
            android:layout_marginBottom="30dp"/>

        <Button
            android:id="@+id/btnCamera"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Take Photo"/>

        <Button
            android:id="@+id/btnGallery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Choose from Gallery"
            android:layout_marginTop="12dp"/>

        <ImageView
            android:id="@+id/imagePreview"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:layout_marginTop="24dp"
            android:scaleType="fitCenter"
            android:contentDescription="Selected image"/>

        <TextView
            android:id="@+id/textImageInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No image selected"
            android:gravity="center"
            android:layout_marginTop="12dp"
            android:textSize="14sp"/>

        <!-- Predicted depth map section -->

        <TextView
            android:id="@+id/textDepthTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Predicted Depth Map"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp"
            android:visibility="gone"/>

        <ImageView
            android:id="@+id/depthPreview"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:scaleType="fitCenter"
            android:contentDescription="Predicted depth map"
            android:visibility="gone"/>

        <Button
            android:id="@+id/btnImportIntrinsics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Import Intrinsics from .txt"
            android:layout_marginBottom="12dp"/>

        <EditText
            android:id="@+id/inputFx"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="fx (focal length X)"
            android:inputType="numberDecimal|numberSigned"/>

        <EditText
            android:id="@+id/inputFy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="fy (focal length Y)"
            android:inputType="numberDecimal|numberSigned"/>

        <EditText
            android:id="@+id/inputCx"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="cx (principal point X)"
            android:inputType="numberDecimal|numberSigned"/>

        <EditText
            android:id="@+id/inputCy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="cy (principal point Y)"
            android:inputType="numberDecimal|numberSigned"/>

        <Button
            android:id="@+id/btnProcess"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Process Image"
            android:layout_marginTop="24dp"/>

        <!-- Destination folder for Float32 metric depth TIFF -->

        <Button
            android:id="@+id/btnSelectOutputFolder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Select Output Folder"
            android:layout_marginTop="12dp"/>

        <TextView
            android:id="@+id/textOutputFolder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No output folder selected"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp"/>

    </LinearLayout>
</ScrollView>
